	<library_kinematics_models id="kmodels">
		<kinematics_model id="kmodel0" name="Fetch_1">
			<asset>
				<subject>:Interface Author: Rosen Diankov

Simplest robot possible that just passes the trajectories to the controller</subject>
			</asset>
			<technique_common>
				<joint name="bellows_joint" sid="joint0">
					<prismatic sid="axis0">
						<axis>0 0 1</axis>
						<limits>
							<min>0</min>
							<max>0.4</max>
						</limits>
					</prismatic>
				</joint>
				<joint name="elbow_flex_joint" sid="joint1">
					<revolute sid="axis0">
						<axis>0 0 1</axis>
